<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyProductsActivity">

    <ImageView
        android:id="@+id/transparentImage"
        android:layout_width="0sp"
        android:layout_height="0sp"
        android:alpha="0.5"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/myProductsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#AF98F6"
        android:gravity="center"
        android:text="Mano produktai"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/productsListView"
        android:layout_width="0sp"
        android:layout_height="0sp"
        app:layout_constraintBottom_toTopOf="@+id/goToAddProductActivity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myProductsTitle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/goToAddProductActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40sp"
        android:layout_marginEnd="40sp"
        android:clickable="true"
        android:contentDescription="addProduct"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add_product" />

    <TextView
        android:id="@+id/noProductsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="Neturite jokių produktų"
        app:layout_constraintTop_toBottomOf="@+id/myProductsTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>